{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "check-types": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"]
    },
    "test": {
      "dependsOn": ["check-types"],
      "inputs": ["$TURBO_DEFAULT$", ".env", "playwright.config.ts"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },
    "test:report": {
      "cache": false,
      "persistent": true
    }
  }
}